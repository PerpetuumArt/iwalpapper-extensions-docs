{
  "schemaVersion": 3,
  "id": "app.iwalpapper.music-wallpaper",
  "version": "0.1.0",
  "kind": "wallpaper",
  "title": "Music",
  "description": "The song that's playing, over a gradient made from its artwork. The native Now Playing wallpaper, made as an extension.",
  "author": { "name": "iWalpapper" },
  "entry": { "path": "index.html", "runtime": "web" },
  "bridgeVersion": 2,
  "playback": "live",
  "permissions": ["nowPlaying"],
  "settings": [
    { "id": "position", "type": "choice", "title": "Position", "group": "Artwork", "options": ["Left", "Centre", "Right"], "default": "Centre" },
    { "id": "size", "type": "slider", "title": "Size", "group": "Artwork", "min": 0.15, "max": 0.8, "step": 0.01, "default": 0.32 },
    { "id": "corners", "type": "slider", "title": "Corners", "group": "Artwork", "min": 0, "max": 1, "step": 0.01, "default": 0.3 },
    { "id": "shadow", "type": "toggle", "title": "Shadow", "group": "Artwork", "default": true },
    { "id": "artworkHover", "type": "toggle", "title": "Artwork hover", "group": "Artwork", "default": true },
    { "id": "showTitle", "type": "toggle", "title": "Title", "group": "Song", "default": true },
    { "id": "showArtist", "type": "toggle", "title": "Artist", "group": "Song", "default": true },
    { "id": "showAlbum", "type": "toggle", "title": "Album", "group": "Song", "default": true },
    { "id": "textSize", "type": "slider", "title": "Text size", "group": "Song", "min": 0, "max": 1, "step": 0.01, "default": 0.4 },
    { "id": "interactive", "type": "toggle", "title": "Interactive", "group": "Controls", "default": true },
    { "id": "showProgress", "type": "toggle", "title": "Progress and time", "group": "Controls", "default": true },
    { "id": "lockProgress", "type": "toggle", "title": "Lock progress bar", "group": "Controls", "default": true },
    { "id": "showPlayPause", "type": "toggle", "title": "Play and pause", "group": "Controls", "default": true },
    { "id": "showSkip", "type": "toggle", "title": "Previous and next", "group": "Controls", "default": true },
    { "id": "showShuffle", "type": "toggle", "title": "Shuffle", "group": "Controls", "default": true },
    { "id": "showRepeat", "type": "toggle", "title": "Repeat", "group": "Controls", "default": true },
    { "id": "fill", "type": "choice", "title": "Fill", "group": "Background", "options": ["Artwork gradient", "Main colour"], "default": "Artwork gradient" },
    { "id": "speed", "type": "slider", "title": "Speed", "group": "Background", "min": 0.25, "max": 4, "step": 0.05, "default": 1 },
    { "id": "movement", "type": "slider", "title": "Movement", "group": "Background", "min": 0, "max": 2, "step": 0.05, "default": 1 },
    { "id": "swirl", "type": "slider", "title": "Swirl", "group": "Background", "min": 0, "max": 1, "step": 0.01, "default": 0.3 },
    { "id": "grain", "type": "slider", "title": "Grain", "group": "Background", "min": 0, "max": 1, "step": 0.01, "default": 0.3 },
    { "id": "dim", "type": "slider", "title": "Dim", "group": "Background", "min": 0, "max": 0.8, "step": 0.01, "default": 0.1 },
    { "id": "transition", "type": "toggle", "title": "Transition", "group": "Background", "default": true },
    { "id": "launcher", "type": "toggle", "title": "Open button", "group": "When nothing plays", "default": true },
    { "id": "launcherStyle", "type": "choice", "title": "Style", "group": "When nothing plays", "options": ["Stamp", "Glass"], "default": "Stamp" },
    { "id": "follow", "type": "apps", "title": "Follow", "group": "Apps" }
  ]
}
